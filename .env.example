# Copy to .env and fill in real values ONLY during the AWS sprint.
# Never commit .env — see .gitignore.

# --- AWS account context ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000

# --- DynamoDB ---
FINDINGS_TABLE_NAME=cloudguard-findings

# --- SNS ---
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:cloudguard-alerts
ALERT_EMAIL=replace-with-your-email@example.com

# --- CIS Scanner ---
CIS_SCAN_SCHEDULE_HOURS=6

# --- Terraform remote state (independent backend, not shared with F3) ---
TF_STATE_BUCKET=cloudguard-pro-tfstate-REPLACE
TF_STATE_LOCK_TABLE=cloudguard-pro-tfstate-lock
TF_STATE_REGION=us-east-1

# --- Pulumi ---
PULUMI_ORG=REPLACE-pulumi-org
PULUMI_STACK=dev
